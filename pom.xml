<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>io.agentscope.examples</groupId>
    <artifactId>agentscope-payroll</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>AgentScope Java - Payroll Platform</name>
    <description>薪酬核算平台：前端（Vue3）、后端（Web）、智能体（运行时）三端拆分</description>

    <modules>
        <module>payroll-common</module>
        <module>payroll-agent</module>
        <module>payroll-backend</module>
        <module>payroll-tests</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <agentscope.version>2.0.1</agentscope.version>
        <!-- POC：仅在 payroll.orchestrator=graph 时使用，与 AgentScope 的 agent/tool 层并存。 -->
        <langgraph4j.version>1.9.8</langgraph4j.version>
        <!-- AgentScope 2.0.1 依赖 Jackson 2.21，覆盖 Spring Boot 默认版本以保持二进制兼容。 -->
        <jackson-bom.version>2.21.1</jackson-bom.version>
    </properties>

    <!--
        多模块拆分后 ES 客户端在 agent/backend 模块中变成传递依赖，
        Spring Boot BOM 会把它们提升到 8.x；这里统一锁回 7.17，保持与运行期客户端一致。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>7.17.28</version>
            </dependency>
            <dependency>
                <groupId>org.elasticsearch.client</groupId>
                <artifactId>elasticsearch-rest-client</artifactId>
                <version>7.17.28</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Windows + JDK 17 下 Mockito inline mock maker 需要允许自附加。 -->
                        <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
