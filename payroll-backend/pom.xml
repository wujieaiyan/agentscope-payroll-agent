<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.agentscope.examples</groupId>
        <artifactId>agentscope-payroll</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>payroll-backend</artifactId>
    <name>Payroll Backend</name>
    <description>Web 后端：鉴权、会话、管理台接口、知识库与 SSE 续流代理</description>

    <dependencies>
        <dependency>
            <groupId>io.agentscope.examples</groupId>
            <artifactId>payroll-common</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>payroll-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                    <mainClass>io.agentscope.examples.payroll.PayrollWebApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- -Prapidocr：引入 PP-OCRv4 原生识别（约 33MB Windows x64 原生库与模型），
             默认构建不打包，RapidOCR 档位自动不可用并回落到 Tesseract。 -->
        <profile>
            <id>rapidocr</id>
            <dependencies>
                <dependency>
                    <groupId>io.github.mymonstercat</groupId>
                    <artifactId>rapidocr</artifactId>
                    <version>0.0.7</version>
                </dependency>
                <dependency>
                    <groupId>io.github.mymonstercat</groupId>
                    <artifactId>rapidocr-onnx-windows-x86_64</artifactId>
                    <version>1.2.2</version>
                </dependency>
                <dependency>
                    <groupId>io.github.mymonstercat</groupId>
                    <artifactId>rapidocr-onnx-models</artifactId>
                    <version>1.2.2</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
