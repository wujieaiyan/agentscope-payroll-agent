<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.agentscope.examples.payroll.db.mapper.AuditMapper">

    <!-- 列名映射全部显式：容器里 map-underscore-to-camel-case=false，漏写一列就是静默 null。 -->
    <resultMap id="auditEntryMap" type="io.agentscope.examples.payroll.domain.AuditEntry">
        <constructor>
            <idArg column="audit_id" javaType="_long"/>
            <arg column="occurred_at" javaType="java.time.LocalDateTime"/>
            <arg column="actor_id" javaType="java.lang.Long"/>
            <arg column="actor_name" javaType="java.lang.String"/>
            <arg column="action" javaType="java.lang.String"/>
            <arg column="resource_type" javaType="java.lang.String"/>
            <arg column="resource_id" javaType="java.lang.String"/>
            <arg column="before_json" javaType="java.lang.String"/>
            <arg column="after_json" javaType="java.lang.String"/>
            <arg column="payload_json" javaType="java.lang.String"/>
            <arg column="ip" javaType="java.lang.String"/>
            <arg column="user_agent" javaType="java.lang.String"/>
            <arg column="result" javaType="java.lang.String"/>
            <arg column="status_code" javaType="java.lang.Integer"/>
            <arg column="message" javaType="java.lang.String"/>
            <arg column="trace_id" javaType="java.lang.String"/>
            <arg column="revision" javaType="java.lang.String"/>
            <arg column="write_result" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="filters">
        <where>
            <if test="from != null">AND occurred_at &gt;= #{from}</if>
            <if test="to != null">AND occurred_at &lt;= #{to}</if>
            <if test="actor != null">AND actor_name LIKE #{actor} ESCAPE '!'</if>
            <if test="action != null">AND action LIKE #{action} ESCAPE '!'</if>
            <if test="resourceType != null">AND resource_type LIKE #{resourceType} ESCAPE '!'</if>
            <if test="resourceId != null">AND resource_id LIKE #{resourceId} ESCAPE '!'</if>
            <if test="result != null">AND result = #{result}</if>
            <if test="keyword != null">
                AND (action LIKE #{keyword} ESCAPE '!'
                OR resource_id LIKE #{keyword} ESCAPE '!'
                OR message LIKE #{keyword} ESCAPE '!'
                OR actor_name LIKE #{keyword} ESCAPE '!')
            </if>
        </where>
    </sql>

    <insert id="insert"
            parameterType="io.agentscope.examples.payroll.db.mapper.AuditInsert"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO audit_log (occurred_at, actor_id, actor_name, action, resource_type,
            resource_id, before_json, after_json, payload_json, ip, user_agent, result,
            status_code, message, trace_id, revision, write_result)
        VALUES (#{entry.occurredAt}, #{entry.actorId}, #{entry.actorName}, #{entry.action},
            #{entry.resourceType}, #{entry.resourceId}, #{entry.beforeJson}, #{entry.afterJson},
            #{entry.payloadJson}, #{entry.ip}, #{entry.userAgent}, #{entry.result},
            #{entry.statusCode}, #{entry.message}, #{entry.traceId}, #{entry.revision},
            #{entry.writeResult})
    </insert>

    <select id="find" resultMap="auditEntryMap">
        SELECT audit_id, occurred_at, actor_id, actor_name, action, resource_type, resource_id,
            before_json, after_json, payload_json, ip, user_agent, result, status_code, message,
            trace_id, revision, write_result
        FROM audit_log
        <include refid="filters"/>
        ORDER BY occurred_at DESC, audit_id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM audit_log
        <include refid="filters"/>
    </select>

    <delete id="purgeBefore">
        DELETE FROM audit_log WHERE occurred_at &lt; #{cutoff}
    </delete>
</mapper>